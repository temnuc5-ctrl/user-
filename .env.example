# ── Supabase (clés publiques uniquement, visibles dans le navigateur) ──────
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://ayshwltvfmrlnkswpjld.supabase.co
# Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# PostgreSQL persistant requis en production.
# Remplacez les exemples par les URL fournies par votre hébergeur.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# URL directe non poolée requise pour les migrations Drizzle.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Sur Netlify, ces variables sont fournies par l’intégration de base de données.
# NETLIFY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# NETLIFY_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Développement local : désactive l'authentification du shell agent-native
# AUTH_DISABLED=true
